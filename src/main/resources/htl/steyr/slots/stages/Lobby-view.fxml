   <children>
      <ListView fx:id="playerListView" layoutX="46.0" layoutY="82.0" prefHeight="200.0" prefWidth="508.0" />
      <Label layoutX="284.0" layoutY="32.0" text="Lobby" />
      <Button fx:id="startgameButton" layoutX="399.0" layoutY="334.0" mnemonicParsing="false" onAction="#startgameButtonClicked" text="START GAME" />
      <Button fx:id="leaveButton" layoutX="46.0" layoutY="337.0" mnemonicParsing="false" onAction="#leaveButtonClicked" text="leave" />
   </children>
</AnchorPane>
